{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toraidl/ColorOS-Port-OTA/schema/device.schema.json",
  "title": "ColorOS port OTA device manifest",
  "type": "object",
  "required": ["device", "version", "romVersion", "url", "id"],
  "additionalProperties": false,
  "properties": {
    "device": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{3,32}$",
      "description": "Device code, upper case, must match ro.product.model"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Human readable marketing names, for documentation only"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "description": "New build id, e.g. KB2000_17.0.0.152(CN01)"
    },
    "romVersion": { "type": "string", "minLength": 1 },
    "coloros": { "type": "string" },
    "android": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["official", "beta", "hotfix", "test"]
    },
    "packageType": { "type": "integer", "minimum": 0 },
    "size": {
      "type": "integer",
      "minimum": 0,
      "description": "Package size in bytes, 0 when unknown"
    },
    "md5": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{32})?$",
      "description": "MD5 hex, empty string when unknown"
    },
    "url": {
      "type": "string",
      "pattern": "^https://",
      "description": "Direct package URL"
    },
    "id": { "type": "string", "minLength": 3 },
    "changelog": {
      "type": "string",
      "description": "Repo-relative path to the Markdown changelog"
    },
    "description": {
      "type": "string",
      "description": "Inline description (source manifests normally use changelog instead)"
    },
    "descriptionUrl": {
      "type": "string",
      "pattern": "^https://"
    }
  }
}
